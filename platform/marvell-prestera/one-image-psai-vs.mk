# sonic marvell-prestera-psai-vs ONE image installer

SONIC_MARVELL_PRESTERA_PSAI_VS_ONE_IMAGE = sonic-marvell-prestera-psai-vs.bin
$(SONIC_MARVELL_PRESTERA_PSAI_VS_ONE_IMAGE)_MACHINE = marvell-prestera-psai-vs
$(SONIC_MARVELL_PRESTERA_PSAI_VS_ONE_IMAGE)_IMAGE_TYPE = onie
$(SONIC_MARVELL_PRESTERA_PSAI_VS_ONE_IMAGE)_INSTALLS += $(SYSTEMD_SONIC_GENERATOR)
$(SONIC_MARVELL_PRESTERA_PSAI_VS_ONE_IMAGE)_LAZY_INSTALLS += $(VS_PLATFORM_MODULE)
# See kvm-image-psai-vs.mk: filter out the real-hardware syncd docker, which
# shares the SONIC_INSTALL_DOCKER_IMAGES global list with this VS flavor.
ifeq ($(INSTALL_DEBUG_TOOLS),y)
$(SONIC_MARVELL_PRESTERA_PSAI_VS_ONE_IMAGE)_DOCKERS += $(filter-out $(DOCKER_SYNCD_BASE_DBG), $(SONIC_INSTALL_DOCKER_DBG_IMAGES))
$(SONIC_MARVELL_PRESTERA_PSAI_VS_ONE_IMAGE)_DOCKERS += $(filter-out $(DOCKER_SYNCD_BASE) $(patsubst %-$(DBG_IMAGE_MARK).gz,%.gz, $(SONIC_INSTALL_DOCKER_DBG_IMAGES)), $(SONIC_INSTALL_DOCKER_IMAGES))
else
$(SONIC_MARVELL_PRESTERA_PSAI_VS_ONE_IMAGE)_DOCKERS = $(filter-out $(DOCKER_SYNCD_BASE), $(SONIC_INSTALL_DOCKER_IMAGES))
endif
SONIC_INSTALLERS += $(SONIC_MARVELL_PRESTERA_PSAI_VS_ONE_IMAGE)
